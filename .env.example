BOT_TOKEN=
# Numeric Telegram user IDs, comma separated.
ADMIN_IDS=
# HTTPS panel base URL, including the custom path, without /panel/api.
PANEL_BASE_URL=https://panel.example.com:10443/custom-path/
PANEL_API_TOKEN=
# Supabase PostgreSQL Session Pooler URI (port 5432), with sslmode=require.
DATABASE_URL=
# Random 32-256 character secret: A-Za-z0-9_-.
TELEGRAM_WEBHOOK_SECRET=
# Optional public subscription prefix including the configured subscription path.
SUBSCRIPTION_BASE_URL=
# Optional PEM CA bundle. TLS verification is always enabled.
PANEL_CA_FILE=
