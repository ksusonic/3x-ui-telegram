BOT_TOKEN=
# Numeric Telegram user IDs, comma separated
ADMIN_IDS=
# Full panel base URL, including its custom path, but without /panel/api
PANEL_BASE_URL=https://panel.example.com:10443/custom-path/
# Prefer a panel API token. Otherwise set both username and password.
PANEL_API_TOKEN=
PANEL_USERNAME=
PANEL_PASSWORD=
# Optional public subscription prefix, including the configured subscription path.
# Leave empty to offer individual connection links only.
SUBSCRIPTION_BASE_URL=
# Optional PEM CA bundle for the panel certificate. TLS verification is always enabled.
PANEL_CA_FILE=
DATABASE_PATH=/var/lib/vpn-telegram-bot/bot.sqlite3
# Vercel only: Supabase PostgreSQL Session Pooler URL with sslmode=require.
# Keep this URL and the database password out of Git and chat.
DATABASE_URL=
# Vercel only: random secret, 32–256 characters [A-Za-z0-9_-].
TELEGRAM_WEBHOOK_SECRET=
