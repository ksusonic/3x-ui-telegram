[Unit]
Description=Private Telegram bot for existing 3x-ui clients
Wants=network-online.target
After=network-online.target x-ui.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=vpn-telegram-bot
Group=vpn-telegram-bot
WorkingDirectory=/opt/vpn-telegram-bot
EnvironmentFile=/etc/vpn-telegram-bot/bot.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/vpn-telegram-bot/.venv/bin/python -m vpnbot
Restart=on-failure
RestartSec=15
StateDirectory=vpn-telegram-bot
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true

[Install]
WantedBy=multi-user.target
